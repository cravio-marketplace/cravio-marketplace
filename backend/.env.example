# Cravio backend — environment variables
# Copy to .env and fill in your real values.

PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Formspree (admin notifications on new vendor / support ticket)
FORMSPREE_ID=your_formspree_id

# Comma-separated list of allowed origins for CORS.
# Use "*" to allow any origin (NOT recommended in production).
FRONTEND_URL=http://localhost:5173

# Secret used for any server-side JWTs. Generate a long random string.
JWT_SECRET=replace_with_a_long_random_string
